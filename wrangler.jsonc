{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "underwriting-audit-pod",
  "main": "src/worker.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "underwriting-audit-pod-db",
      "database_id": "f53a3fbe-8927-4845-8a7d-b831c7583d15"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
